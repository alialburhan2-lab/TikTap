<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/test_title" />

        <TextView
            android:id="@+id/tv_limit"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Big counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="56sp" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/taps_label" />
    </LinearLayout>

    <!-- Small stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/StatCell">
            <TextView android:id="@+id/tv_manual" style="@style/Text.StatValue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/primary" />
            <TextView style="@style/Text.StatLabel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/manual" />
        </LinearLayout>

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <LinearLayout style="@style/StatCell">
            <TextView android:id="@+id/tv_auto" style="@style/Text.StatValue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/accent" />
            <TextView style="@style/Text.StatLabel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/auto" />
        </LinearLayout>

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <LinearLayout style="@style/StatCell">
            <TextView android:id="@+id/tv_tps" style="@style/Text.StatValue"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" />
            <TextView style="@style/Text.StatLabel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/tps" />
        </LinearLayout>

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <LinearLayout style="@style/StatCell">
            <TextView android:id="@+id/tv_time" style="@style/Text.StatValue"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00:00" />
            <TextView style="@style/Text.StatLabel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/time" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tap pad -->
    <com.tiktap.app.TapPadView
        android:id="@+id/tap_pad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:minHeight="180dp" />

    <!-- Speed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/speed" />

            <TextView
                android:id="@+id/tv_speed_value"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:progressTint="@color/primary"
            android:thumbTint="@color/primary" />
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_toggle"
            style="@style/Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/start" />

        <Space android:layout_width="@dimen/gap" android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_reset"
            style="@style/Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reset" />
    </LinearLayout>
</LinearLayout>
