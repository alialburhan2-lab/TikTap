<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/home_intro"
            android:textAlignment="viewStart" />

        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/StatCell">
                <TextView android:id="@+id/stat_lifetime" style="@style/Text.StatValue"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" />
                <TextView style="@style/Text.StatLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stat_lifetime" />
            </LinearLayout>

            <Space android:layout_width="@dimen/gap" android:layout_height="1dp" />

            <LinearLayout style="@style/StatCell">
                <TextView android:id="@+id/stat_best" style="@style/Text.StatValue"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" />
                <TextView style="@style/Text.StatLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stat_best" />
            </LinearLayout>

            <Space android:layout_width="@dimen/gap" android:layout_height="1dp" />

            <LinearLayout style="@style/StatCell">
                <TextView android:id="@+id/stat_speed" style="@style/Text.StatValue"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
                <TextView style="@style/Text.StatLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stat_speed" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action: test -->
        <LinearLayout
            android:id="@+id/btn_open_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_action_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_tap" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/open_test" android:textSize="17sp" android:textStyle="bold" />
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="@string/open_test_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action: settings -->
        <LinearLayout
            android:id="@+id/btn_open_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:background="@drawable/bg_action_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_settings" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/open_settings" android:textSize="17sp" android:textStyle="bold" />
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="@string/open_settings_sub" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_warning"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="@string/safety_note"
            android:textAlignment="viewStart"
            android:textColor="@color/warning_text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
