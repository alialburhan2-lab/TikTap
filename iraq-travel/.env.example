# ---------------------------------------------------------------
# IRAQ TRAVEL — environment variables (copy to .env.local)
# Never commit real secrets. All values below are placeholders.
# ---------------------------------------------------------------

# Public site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (optional locally; REQUIRED in production) ---
# When these are empty the app runs on the local demo data store (.data/store.json).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by admin server actions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Session signing secret (REQUIRED in production, min 32 chars) ---
AUTH_SECRET=

# --- Demo authentication (local development only) ---
# Enabled by default when NODE_ENV != production and Supabase is not configured.
# Set to "false" to disable. Demo auth is always disabled in production unless explicitly "true".
DEMO_AUTH_ENABLED=
DEMO_ADMIN_PASSWORD=

# --- Show clearly-labelled DEMO hotels/restaurants/prices (true/false) ---
NEXT_PUBLIC_SHOW_DEMO_DATA=true

# --- Currency reference rate (IQD per 1 USD). Verify with the Central Bank of Iraq. ---
NEXT_PUBLIC_IQD_PER_USD=1310

# --- Maps (optional). OpenStreetMap tiles are used when no Mapbox token is set. ---
NEXT_PUBLIC_MAPBOX_TOKEN=
