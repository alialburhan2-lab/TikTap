# ======================================================
# غسان البرهان | المنصة الرسمية — متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم. لا تضع مفاتيح حقيقية في المستودع.
# ======================================================

# قاعدة البيانات PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ghassan?schema=public"
# اتصال مباشر للترحيلات (مع Supabase/Neon ضع رابط الاتصال المباشر غير المجمّع؛ محلياً نفس DATABASE_URL)
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/ghassan?schema=public"

# Auth.js — أنشئ قيمة عشوائية: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# ضعها true عند التشغيل خلف بروكسي/استضافة موثوقة (Vercel تضبطها تلقائياً)
AUTH_TRUST_HOST=true

# الرابط العام للموقع (يُستخدم في SEO وخريطة الموقع والروابط القانونية)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# حساب المالك الأول (يُنشأ عند تشغيل seed فقط إن لم يكن موجوداً)
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_NAME="غسان البرهان"

# إنشاء بيانات تجريبية عند seed (true/false)
SEED_DEMO=true

# تخزين الوسائط: local أو cloudinary أو vercel-blob (يتطلب BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER=local
# مسار التخزين المحلي (خارج مجلد public؛ يُخدم عبر /uploads)
UPLOAD_DIR="./uploads"
# الحد الأقصى لحجم الصورة بالميغابايت
MAX_UPLOAD_MB=8

# Cloudinary (عند STORAGE_DRIVER=cloudinary) — تبقى على الخادم فقط
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="ghassan"

# ملح لتجزئة عناوين IP في إحصائيات الزيارات (لا تُخزن العناوين بشكل صريح)
ANALYTICS_SALT="change-me-random-salt"
