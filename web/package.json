{
  "name": "ghassan-alburhan-platform",
  "version": "1.0.0",
  "private": true,
  "description": "غسان البرهان | المنصة الرسمية — منصة صحفية وثقافية",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2",
    "react-dom": "19.2",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  },
  "engines": {
    "node": ">=20.9"
  }
}
